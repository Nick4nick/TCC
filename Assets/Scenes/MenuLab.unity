  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "MENU LAB\nUm jogo educativo desenvolvido como Trabalho de Conclus\xE3o
    de Curso em Ci\xEAncia da Computa\xE7\xE3o.\n\nDesenvolvimento\nNick Kuerten
    da Silva\n\nOrienta\xE7\xE3o\nProf. Gi\xE1como Ant\xF4nio Althoff Bolan\n\nCoorienta\xE7\xE3o\nAlessandra
    Zanette Ghisi Frassetto\n\nContribui\xE7\xE3o Acad\xEAmica\nCurso de Nutri\xE7\xE3o
    \u2014 UNESC\n\nInstitui\xE7\xE3o\nUniversidade do Extremo Sul Catarinense \u2014
    UNESC\n\nM\xFAsica e efeitos sonoros\nSite Pixabay\n\nAlguns elementos do jogo\nSite
    Flaticon e Site Canva\n\nRecursos e ferramentas\nO desenvolvimento do projeto
    contou com o aux\xEDlio de ferramentas de Intelig\xEAncia Artificial, utilizadas
    como apoio na elabora\xE7\xE3o de textos, desenvolvimento e revis\xE3o de c\xF3digo,
    cria\xE7\xE3o e edi\xE7\xE3o de imagens e idea\xE7\xE3o de elementos do projeto,
    incluindo ChatGPT, Claude e Gemini.\n\nSobre o jogo\nEste jogo foi desenvolvido
    com finalidade educativa, buscando proporcionar uma experi\xEAncia de aprendizagem
    sobre o planejamento e a montagem de card\xE1pios em diferentes contextos de
    alimenta\xE7\xE3o coletiva, por meio de desafios de sele\xE7\xE3o e combina\xE7\xE3o
    de alimentos."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2aa4e65b46a923b4889915eae5b86da6, type: 2}
